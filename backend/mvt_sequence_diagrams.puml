' ========================================================
' 1. ระบบสมัครสมาชิก (User Registration)
' ========================================================
@startuml 1_User_Registration
title 1. ระบบสมัครสมาชิก (User Registration)
hide footbox
autonumber

actor "ผู้ใช้งาน\n(User)" as User
participant "Browser" as Browser
participant "<<View>>\nRegisterView" as View
participant "<<Form>>\nRegisterForm" as Form
participant "<<Model>>\nUser" as Model
database "Database" as DB

User -> Browser: กรอกข้อมูลและกดสมัครสมาชิก
activate Browser

Browser -> View: POST /register/\n(form_data)
activate View

View -> Form: RegisterForm(POST)
activate Form

Form -> Form: is_valid()
alt [form valid]
    Form --> View: True
    View -> Form: save(commit=False)
    Form --> View: user (unsaved)
    
    View -> Model: user.save()
    activate Model
    Model -> DB: INSERT auth_user SET ...
    activate DB
    DB --> Model: OK
    deactivate DB
    Model --> View: OK
    deactivate Model
    
    View --> Browser: redirect('home')\n+ messages.success(...)
else [form invalid]
    Form --> View: False
    deactivate Form
    View --> Browser: render register.html\n(form with errors)
end
deactivate View

Browser --> User: แสดงผลลัพธ์บนหน้าจอ
deactivate Browser
@enduml

' ========================================================
' 2. ระบบยืนยันตัวตน (Identity Verification)
' ========================================================
@startuml 2_Identity_Verification
title 2. ระบบยืนยันตัวตน (Identity Verification)
hide footbox
autonumber

actor "ผู้ใช้งาน\n(User)" as User
participant "Browser" as Browser
participant "<<View>>\nVerificationView" as View
participant "<<Form>>\nVerificationForm" as Form
participant "<<Model>>\nVerification Request" as Model
database "Database" as DB

User -> Browser: อัปโหลดรูปภาพและกดยืนยัน
activate Browser

Browser -> View: POST /verify/\n(image_data)
activate View

View -> Form: VerificationForm(POST, FILES)
activate Form

Form -> Form: is_valid()
alt [form valid]
    Form --> View: True
    View -> Form: save(commit=False)
    Form --> View: verification (unsaved)
    
    View -> Model: verification.status = 'pending'\nverification.user = request.user\nverification.save()
    activate Model
    Model -> DB: INSERT verification SET ...
    activate DB
    DB --> Model: OK
    deactivate DB
    Model --> View: OK
    deactivate Model
    
    View --> Browser: redirect('profile')\n+ messages.info('รอการอนุมัติ')
else [form invalid]
    Form --> View: False
    deactivate Form
    View --> Browser: render verify.html\n(form with errors)
end
deactivate View

Browser --> User: แสดงสถานะการรออนุมัติ
deactivate Browser
@enduml

' ========================================================
' 3. ระบบแอดมินอนุมัติผู้ใช้ (Admin Approve Users)
' ========================================================
@startuml 3_Admin_Approve_Users
title 3. ระบบแอดมินอนุมัติผู้ใช้ (Admin Approve Users)
hide footbox
autonumber

actor "ผู้ดูแลระบบ\n(Admin)" as Admin
participant "Browser" as Browser
participant "<<View>>\nAdminApproveUserView" as View
participant "<<Model>>\nUser" as UserModel
participant "<<Model>>\nNotification" as NotiModel
database "Database" as DB

Admin -> Browser: คลิกอนุมัติผู้ใช้
activate Browser

Browser -> View: POST /admin/approve_user/<id>/
activate View

View -> UserModel: objects.get(id=userId)
activate UserModel
UserModel -> DB: SELECT * FROM auth_user WHERE id=...
activate DB
DB --> UserModel: row
deactivate DB
UserModel --> View: user_obj
deactivate UserModel

View -> UserModel: user_obj.status = 'approved'\nuser_obj.save()
activate UserModel
UserModel -> DB: UPDATE auth_user SET status='approved' ...
activate DB
DB --> UserModel: OK
deactivate DB
UserModel --> View: OK
deactivate UserModel

View -> NotiModel: objects.create(user=user_obj, message="Approved")
activate NotiModel
NotiModel -> DB: INSERT notification SET ...
activate DB
DB --> NotiModel: OK
deactivate DB
NotiModel --> View: OK
deactivate NotiModel

View --> Browser: redirect('admin_user_list')\n+ messages.success(...)
deactivate View

Browser --> Admin: แสดงผลการอนุมัติสำเร็จ
deactivate Browser
@enduml

' ========================================================
' 4. ระบบเพิ่มสินค้า (Create Product)
' ========================================================
@startuml 4_Create_Product
title 4. ระบบเพิ่มสินค้า (Create Product)
hide footbox
autonumber

actor "ผู้ขาย\n(Seller)" as User
participant "Browser" as Browser
participant "<<View>>\nProductCreateView" as View
participant "<<Form>>\nProductForm" as Form
participant "<<Model>>\nProduct" as Model
database "Database" as DB

User -> Browser: กรอกข้อมูลสินค้าและกดยืนยัน
activate Browser

Browser -> View: POST /products/create/\n(data, images)
activate View

View -> Form: ProductForm(POST, FILES)
activate Form

Form -> Form: is_valid()
alt [form valid]
    Form --> View: True
    View -> Form: save(commit=False)
    Form --> View: product (unsaved)
    
    View -> Model: product.seller = request.user\nproduct.status = 'pending'\nproduct.save()
    activate Model
    Model -> DB: INSERT product SET ...
    activate DB
    DB --> Model: OK
    deactivate DB
    Model --> View: OK
    deactivate Model
    
    View --> Browser: redirect('product_list')\n+ messages.success(...)
else [form invalid]
    Form --> View: False
    deactivate Form
    View --> Browser: render product_form.html\n(form with errors)
end
deactivate View

Browser --> User: แสดงผลการเพิ่มสินค้า
deactivate Browser
@enduml

