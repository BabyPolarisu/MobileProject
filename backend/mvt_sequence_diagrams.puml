' ========================================================
' 7. ระบบแชท (Chat System via WebSocket)
' ========================================================
@startuml 7_Chat_System
title 7. ระบบแชท (Chat System via WebSocket)
hide footbox
autonumber

actor "ผู้ใช้งาน\n(User)" as User
participant "Browser" as Browser
participant "<<Consumer>>\nChatConsumer" as Consumer
participant "<<Model>>\nChatRoom" as RoomModel
participant "<<Model>>\nMessage" as MsgModel
database "Database" as DB

User -> Browser: พิมพ์ข้อความและกดส่ง
activate Browser

Browser -> Consumer: WebSocket SEND\n{"message": content, "roomId": id}
activate Consumer

Consumer -> RoomModel: objects.get(id=roomId)
activate RoomModel
RoomModel -> DB: SELECT * FROM chatroom WHERE id=...
activate DB
DB --> RoomModel: row
deactivate DB
RoomModel --> Consumer: room_obj
deactivate RoomModel

Consumer -> MsgModel: objects.create(room=room_obj, sender=user, content=...)
activate MsgModel
MsgModel -> DB: INSERT message SET ...
activate DB
DB --> MsgModel: OK
deactivate DB
MsgModel --> Consumer: msg_obj
deactivate MsgModel

Consumer -> Consumer: group_send(roomId, message_data)
Consumer --> Browser: WebSocket RECEIVE\n(new message)
deactivate Consumer

Browser --> User: แสดงข้อความใหม่ในหน้าจอ
deactivate Browser
@enduml

